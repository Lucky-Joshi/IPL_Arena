# Frontend (Next.js / Vercel) — copy to .env.local for local overrides.
# NOTE: These files are documentation only. Next.js reads .env.local automatically,
# but Vercel injects real values from the Dashboard (Project > Settings > Environment Variables).
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME. After changing this on Vercel,
# trigger a new deploy; existing builds will keep the old URL.
#
# Production value (Render backend):
NEXT_PUBLIC_API_URL=https://t20-dynasty-backend.onrender.com
#
# Local development (run backend on port 4000):
# NEXT_PUBLIC_API_URL=http://localhost:4000
