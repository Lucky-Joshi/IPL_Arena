# Backend (Node.js / Render Web Service) — documentation template.
# Node does NOT auto-load .env files. Set these in the Render Dashboard
# (Service > Environment) or export them in your shell for local runs.
#
# Port the HTTP server binds. Render injects PORT automatically; leave this
# unset on Render. Locally the default is 4000.
PORT=4000
#
# URL of the Python AI decision service (no trailing slash).
# Production (Render):
AI_URL=https://t20-dynasty-ai.onrender.com
# Local development:
# AI_URL=http://localhost:5000
#
# Absolute path to the single JSON state file. On Render this MUST live on a
# persistent disk mounted at /var/data. Free-tier web services have an
# ephemeral filesystem, so a paid plan with a disk is required for durable saves.
# Local development uses ./data/auction-state.json when this is unset.
SAVE_FILE=/var/data/auction-state.json
