# AI decision service (Python / Render Web Service) — documentation template.
# Python does NOT auto-load .env files. Set these in the Render Dashboard
# (Service > Environment) or export them in your shell for local runs.
#
# Port the HTTP server binds. Render injects PORT automatically; leave this
# unset on Render (the service reads it first). Default is 5000.
PORT=5000
#
# Legacy local-development override, used only when PORT is not set.
# AI_PORT=5000
